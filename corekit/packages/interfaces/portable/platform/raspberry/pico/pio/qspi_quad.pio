;
; CoreKit native quad-SPI engine for RP2 PIO.
;
; DMA feeds/consumes the FIFOs. The write path pushes a completion token only
; after the final nibble reached the pins, avoiding TXSTALL polling. Read has a
; distinct command loop so that token can never leak into the RX payload FIFO.
;
.program corekit_qspi_quad
.side_set 1

public write_bits:
    out pins, 4             side 0
    jmp x-- write_bits      side 1
    set pins, 0             side 0
    set x, 0                side 0
    mov isr, x              side 0
    push block              side 0
public write_bits_end:

public read_command_bits:
    out pins, 4             side 0
    jmp x-- read_command_bits side 1
    set pins, 0             side 0
    set pindirs, 0          side 0
read_byte:
    set x, 0                side 1
read_bits:
    in pins, 4              side 0
    jmp x-- read_bits       side 1
    in pins, 4              side 0
    jmp y-- read_byte       side 0
public read_bits_end:
