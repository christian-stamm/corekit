.program shifter
.side_set 1 opt
; sideset (CLK)

.define PUBLIC SHIFTER_READY 0
.define PUBLIC MUXER_READY 1

    mov     pins,       null                side 0
.wrap_target    
    irq     clear       SHIFTER_READY       side 0      ; set pulser trigger 
    mov     x,          y                   side 0      ; load cols & latch row
shift:
    pull    block                           side 0
    out     pins,       24                  side 0
    in      osr,        8                   side 1
    pull    block                           side 1
    in      osr,        24                  side 0
    mov     pins,       isr                 side 0
    mov     isr,        osr                 side 1
    pull    block                           side 1
    in      osr,        16                  side 0
    mov     pins,       isr                 side 0
    mov     isr,        osr                 side 1
    in      null,       8                   side 1
    mov     pins,       isr                 side 0 [1]
    jmp     x--,        shift               side 1 [1]
sync:
    irq     set         SHIFTER_READY       side 0      ; set pulser trigger
    wait    1 irq       MUXER_READY         side 0      ; clear shift trigger
.wrap