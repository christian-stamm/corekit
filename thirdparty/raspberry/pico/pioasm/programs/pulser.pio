.program pulser
.side_set 2 opt
; sideset (PWR | LAT)

.define PUBLIC SHIFTER_READY 0
.define PUBLIC MUXER_READY   1

.wrap_target
    wait    1 irq,      SHIFTER_READY    side 0b10  [3]  ; wait for shifter ready
    irq     clear       MUXER_READY      side 0b10  [3]  ; clear pulser ready
select:
    out     pins        8                side 0b11  [3]  ; select lane and latch
load:
    out     x,          8                side 0b11  [3]  ; load delay
    out     y,          16               side 0b10  [3]  ; load delay
    irq     set         MUXER_READY      side 0b10       ; clear pulser ready
skip:
    jmp     !x,         runT1            side 0b10       ; skip if zero
runT0:
    jmp     x--,        runT0            side 0b10       ; pulse delay
runT1:
    jmp     y--,        runT1            side 0b00       ; pulse delay
.wrap