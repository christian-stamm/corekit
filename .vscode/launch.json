{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RP2350 Debug",
            "type": "cortex-debug",
            "request": "launch",
            "executable": "${command:cmake.launchTargetPath}",
            "cwd": "${env:PICO_DEBUG_PATH}/tcl",
            "servertype": "openocd",
            "gdbPath": "gdb-multiarch",
            "device": "RP2350",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "svdPath": "/opt/pico/pico-sdk/src/rp2350/hardware_regs/RP2350.svd",
            "overrideLaunchCommands": [
                "monitor reset init",
                "load \"${command:cmake.launchTargetPath}\""
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ],
        },
        {
            "name": "RP2040 Debug",
            "type": "cortex-debug",
            "request": "launch",
            "executable": "${command:cmake.launchTargetPath}",
            "cwd": "${env:PICO_DEBUG_PATH}/tcl",
            "servertype": "openocd",
            "gdbPath": "gdb-multiarch",
            "device": "RP2040",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2040.cfg"
            ],
            "svdPath": "/opt/pico/pico-sdk/src/rp2040/hardware_regs/RP2040.svd",
            "overrideLaunchCommands": [
                "monitor reset init",
                "load \"${command:cmake.launchTargetPath}\""
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ],
        },
    ]
}