{
    "version": 6,
    "configurePresets": [
        {
            "name": "corekit-base",
            "generator": "Ninja",
            "displayName": "Corekit Base Toolchain",
            "binaryDir": "${sourceDir}/build/corekit",
            "cacheVariables": {
                "COREKIT_BUILD_TEST": true,
                "COREKIT_PAL": "<NO PAL SET>",
                "COREKIT_BSP": "pico",
                "PICO_BOARD": "bernd"
            }
        },
        {
            "name": "corekit-stdlib",
            "inherits": "corekit-base",
            "displayName": "Corekit Standard Library",
            "binaryDir": "${sourceDir}/build/corekit/stdlib",
            "cacheVariables": {
                "COREKIT_PAL": "stdlib",
                "COREKIT_BSP": "generic"
            }
        },
        {
            "name": "corekit-freertos",
            "inherits": "corekit-base",
            "displayName": "Corekit FreeRTOS",
            "binaryDir": "${sourceDir}/build/corekit/freertos",
            "cacheVariables": {
                "COREKIT_PAL": "freertos"
            }
        },
        {
            "name": "corekit-baremetal",
            "inherits": "corekit-base",
            "displayName": "Corekit Baremetal",
            "binaryDir": "${sourceDir}/build/corekit/baremetal",
            "cacheVariables": {
                "COREKIT_PAL": "baremetal"
            }
        }
    ]
}