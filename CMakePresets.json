{
    "version": 6,
    "configurePresets": [
        {
            "name": "corekit-base",
            "generator": "Ninja",
            "displayName": "Corekit Base Toolchain",
            "binaryDir": "${sourceDir}/build/corekit-lib",
            "cacheVariables": {
                "CMAKE_C_STANDARD": "17",
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",

                "COREKIT_PAL_FILE": "${sourceDir}/cmake/pal/freertos.cmake",
                "COREKIT_BSP_FILE": "${sourceDir}/cmake/bsp/posix.cmake"
            }
        }
    ]
}